{
  "name": "gym21",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "apps/client",
    "apps/server"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace @gym21/server",
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace @gym21/client",
    "dev:server": "npm run dev --workspace @gym21/server",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "overrides": {
    "@better-auth/core": "1.6.30",
    "kysely": "^0.28.17",
    "vite": "^6.4.3"
  }
}
