APP_PORT=8080

POSTGRES_DB=gym21
POSTGRES_USER=gym21
POSTGRES_PASSWORD=
# Native dev only; Compose derives its URL from POSTGRES_* (escapes credentials).
DATABASE_URL=
DATABASE_SSL=false

APP_BASE_URL=http://localhost:8080
AUTH_BASE_URL=http://localhost:8080/api/auth
ALLOWED_ORIGINS=http://localhost:8080
PORT=8788
HOST=0.0.0.0
TRUST_PROXY=1
JSON_BODY_LIMIT=10mb
RATE_LIMITS_ENABLED=true
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_MAX_CONCURRENT=4
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_USERNAME_CHECK_WINDOW_MS=60000
RATE_LIMIT_AUTH_USERNAME_CHECK_MAX=30
RATE_LIMIT_SYNC_WINDOW_MS=60000
RATE_LIMIT_SYNC_MAX=20
RATE_LIMIT_SYNC_MAX_CONCURRENT=1
RATE_LIMIT_AI_WINDOW_MS=300000
RATE_LIMIT_AI_MAX=3
RATE_LIMIT_AI_MAX_CONCURRENT=1

BETTER_AUTH_SECRET=
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=Gym Gym 21
TELEGRAM_BOT_TOKEN=
TELEGRAM_PLACEHOLDER_EMAIL_DOMAIN=telegram.local.invalid

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/var/secrets/google-application-credentials.json
AI_MODEL=gemini-3-flash-preview
AI_TIMEOUT_MS=12000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_CONTEXT_CHARS=8000
AI_MAX_RECENT_LOGS=40
AI_MAX_EXERCISE_COUNT=50
AI_TEXT_FIELD_MAX_LENGTH=400

# Bounded runtime waits (milliseconds). Migrations/large backups have a larger DB budget.
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=120000
DB_QUERY_TIMEOUT_MS=125000
DB_MIGRATION_TIMEOUT_MS=600000
READINESS_TIMEOUT_MS=2000
STARTUP_TIMEOUT_MS=610000
SHUTDOWN_TIMEOUT_MS=15000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_IDLE_TIMEOUT_MS=130000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
RATE_LIMIT_STORE_TIMEOUT_MS=2000
RATE_LIMIT_LEASE_MS=60000
