{
  "name": "@gym21/server",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch --clear-screen=false --conditions=gym21-source --env-file-if-exists=../../.env src/server.ts",
    "test": "npm run build && node --test test/*.test.js",
    "import:storage-json": "node scripts/import-storage-json.mjs",
    "prebuild": "npm run build --workspace @gym21/contracts",
    "lint": "eslint src --max-warnings 0",
    "test:integration": "node scripts/require-test-database.mjs && npm test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "typescript-eslint": "^8.54.0",
    "globals": "^17.3.0"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.30",
    "@google/genai": "^1.40.0",
    "better-auth": "1.6.30",
    "express": "^5.2.1",
    "pg": "^8.20.0",
    "zod": "^4.3.6",
    "@gym21/contracts": "0.0.0"
  }
}
